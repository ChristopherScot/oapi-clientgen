// The Go client's paging tests and these cover the same behaviours on
// purpose: same pages walked, same early exit, same repeated-cursor
// guard. The one difference is how a failure arrives - Go yields it,
// this rejects - and the test for it asserts the rejection rather than
// pretending the shapes match.
//
// Run with `node --test` (Node 22+ strips the types; no build step).
import { test } from 'node:test'
import assert from 'node:assert/strict'
import { paged, type Page } from './paging{{ if .Published }}.ts{{ end }}'

// Pages built from a list, so a test says what the server returns and
// nothing else.
function server(pages: Page<number>[]): {
  fetch: (cursor: string | undefined) => Promise<Page<number>>
  calls: () => number
} {
  let calls = 0
  return {
    fetch: async (cursor) => {
      calls++
      const i = cursor === undefined ? 0 : Number(cursor)
      return pages[i]
    },
    calls: () => calls,
  }
}

test('walks every page', async () => {
  const s = server([
    { items: [1, 2], next: '1' },
    { items: [3], next: '2' },
    { items: [4, 5] },
  ])

  const got: number[] = []
  for await (const n of paged(s.fetch)) got.push(n)

  assert.deepEqual(got, [1, 2, 3, 4, 5])
  assert.equal(s.calls(), 3)
})

// An early break must stop fetching.
test('break stops fetching', async () => {
  const s = server([
    { items: [1, 2], next: '1' },
    { items: [3], next: '2' },
    { items: [4] },
  ])

  const got: number[] = []
  for await (const n of paged(s.fetch)) {
    got.push(n)
    if (n === 2) break
  }

  assert.deepEqual(got, [1, 2])
  assert.equal(s.calls(), 1, 'breaking should not have asked for page 2')
})

// Where Go yields (zero, err) as a final element, this rejects - and
// the items from before the failure are still delivered, so a caller
// cannot mistake a truncated list for a complete one.
test('a failure rejects, after delivering what arrived', async () => {
  const boom = new Error('page 2 failed')
  let calls = 0
  const fetch = async (cursor: string | undefined): Promise<Page<number>> => {
    calls++
    if (cursor === undefined) return { items: [1, 2], next: '1' }
    throw boom
  }

  const got: number[] = []
  await assert.rejects(async () => {
    for await (const n of paged(fetch)) got.push(n)
  }, boom)

  assert.deepEqual(got, [1, 2])
  assert.equal(calls, 2)
})

// A server that repeats a cursor would otherwise spin forever.
test('a repeated cursor ends the iteration', async () => {
  let calls = 0
  const fetch = async (): Promise<Page<number>> => {
    calls++
    return { items: [1], next: 'same' }
  }

  const got: number[] = []
  for await (const n of paged(fetch)) {
    got.push(n)
    // Bounded, so a broken guard fails here rather than running until
    // the harness kills it.
    assert.ok(got.length <= 100, 'iterated past 100 items on a repeating cursor')
  }

  assert.deepEqual(got, [1, 1])
  assert.equal(calls, 2, 'the second page repeated the cursor, so there is no third')
})

// The check runs before the fetch, not after: an already-aborted
// signal must cost zero requests. Checked after, this still rejects -
// one page late. The Go suite asserts the same thing.
test('an already-aborted signal fetches nothing', async () => {
  const ac = new AbortController()
  ac.abort()
  let calls = 0
  const fetch = async (): Promise<Page<number>> => {
    calls++
    return { items: [1], next: '1' }
  }

  await assert.rejects(async () => {
    for await (const _ of paged(fetch, ac.signal)) {
      // no body: the rejection is the subject
    }
  }, /aborted/i)

  assert.equal(calls, 0, 'an aborted signal should not have reached the server')
})

// Fetch takes a signal, so it has to arrive - on every page, not just
// the first. Without it an in-flight request cannot be cancelled, only
// the gap between pages, and a long pagination is where a caller
// cancels. Go cannot get this wrong: its Fetch takes ctx as a required
// parameter, where TypeScript's signal is optional.
test('the signal is handed to fetch', async () => {
  const ac = new AbortController()
  const got: (AbortSignal | undefined)[] = []
  const fetch = async (
    cursor: string | undefined,
    signal?: AbortSignal
  ): Promise<Page<number>> => {
    got.push(signal)
    return cursor === undefined ? { items: [1], next: '1' } : { items: [2] }
  }

  for await (const _ of paged(fetch, ac.signal)) {
    // no body: what fetch received is the subject
  }

  assert.deepEqual(got, [ac.signal, ac.signal], 'fetch was not given the signal on every page')
})

// Not only a cursor that repeats immediately: a server alternating
// between two cursors never repeats consecutively, so remembering just
// the last one spins forever. The Set remembers all of them.
test('an alternating cursor ends the iteration', async () => {
  let calls = 0
  const fetch = async (cursor: string | undefined): Promise<Page<number>> => {
    calls++
    return { items: [calls], next: cursor === 'A' ? 'B' : 'A' }
  }

  const got: number[] = []
  for await (const n of paged(fetch)) {
    got.push(n)
    assert.ok(got.length <= 100, 'iterated past 100 items on an alternating cursor')
  }

  assert.equal(calls, 3, 'the third page repeated cursor A, so there is no fourth')
})

test('an aborted signal rejects', async () => {
  const ac = new AbortController()
  const fetch = async (): Promise<Page<number>> => ({ items: [1], next: '1' })

  const got: number[] = []
  await assert.rejects(async () => {
    for await (const n of paged(fetch, ac.signal)) {
      got.push(n)
      ac.abort()
    }
  }, /aborted/i)

  assert.deepEqual(got, [1])
})
