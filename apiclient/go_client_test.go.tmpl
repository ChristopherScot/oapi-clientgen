func TestClientSendsVersionHeader(t *testing.T) {
	var got string
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		got = r.Header.Get(ClientVersionHeader)
	}))
	defer srv.Close()

	req, _ := http.NewRequest(http.MethodGet, srv.URL, nil)
	if _, err := NewHTTPClient("test").Do(req); err != nil {
		t.Fatal(err)
	}
	if got != ClientVersion {
		t.Errorf("%s = %q, want %q", ClientVersionHeader, got, ClientVersion)
	}
}

func TestRetryIsBoundedAndBreakerOpens(t *testing.T) {
	var hits int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		hits++
		w.WriteHeader(http.StatusInternalServerError)
	}))
	defer srv.Close()

	// The default policy needs MinRequests before a rate means
	// anything, so an everything-fails dependency is asked that many
	// times and then no more.
	p := DefaultBreakerPolicy()
	c := NewHTTPClient("test", WithPolicy(NoRetry{}), WithBreakerPolicy(p))
	var opened int
	for i := 0; i < p.MinRequests+5; i++ {
		req, _ := http.NewRequest(http.MethodGet, srv.URL, nil)
		if _, err := c.Do(req); err == ErrCircuitOpen {
			opened++
		}
	}
	if hits != p.MinRequests {
		t.Errorf("upstream saw %d requests, want %d before the breaker opened", hits, p.MinRequests)
	}
	if opened != 5 {
		t.Errorf("%d calls rejected by an open circuit, want 5", opened)
	}
}

// A POST may already have applied.
func TestPostIsNeverRetried(t *testing.T) {
	var hits int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		hits++
		w.WriteHeader(http.StatusInternalServerError)
	}))
	defer srv.Close()

	req, _ := http.NewRequest(http.MethodPost, srv.URL, strings.NewReader("{}"))
	NewHTTPClient("test").Do(req)
	if hits != 1 {
		t.Errorf("POST made %d attempts, want 1", hits)
	}
}

func TestIdempotentRequestIsRetriedOnce(t *testing.T) {
	var hits int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		hits++
		w.WriteHeader(http.StatusInternalServerError)
	}))
	defer srv.Close()

	req, _ := http.NewRequest(http.MethodGet, srv.URL, nil)
	NewHTTPClient("test").Do(req)
	if hits != 2 {
		t.Errorf("GET made %d attempts, want 2 (initial + one retry)", hits)
	}
}

// The server knows when capacity returns; the client does not.
func TestRetryAfterBeatsThePolicyBackoff(t *testing.T) {
	var hits int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		hits++
		if hits == 1 {
			w.Header().Set("Retry-After", "2")
			w.WriteHeader(http.StatusTooManyRequests)
			return
		}
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	start := time.Now()
	req, _ := http.NewRequest(http.MethodGet, srv.URL, nil)
	resp, err := NewHTTPClient("test").Do(req)
	if err != nil {
		t.Fatal(err)
	}
	elapsed := time.Since(start)

	if resp.StatusCode != http.StatusOK {
		t.Errorf("status = %d, want 200 after the retry", resp.StatusCode)
	}
	if elapsed < 2*time.Second {
		t.Errorf("waited %v, want >= 2s - the server's Retry-After was ignored", elapsed)
	}
}

// Sleeping an hour inside a request is indistinguishable from a hang.
func TestRetryAfterIsCapped(t *testing.T) {
	resp := &http.Response{Header: http.Header{"Retry-After": []string{"3600"}}}
	_, ok, tooLong := retryAfter(resp, 30*time.Second)
	if ok {
		t.Error("accepted an hour-long Retry-After as a wait")
	}
	if !tooLong {
		t.Error("an hour-long Retry-After must report tooLong, or the caller substitutes its own shorter backoff")
	}
}

// A negative delay is not a wait. "-0" is the one that needs saying:
// Atoi reads it as 0 with no error, so a numeric test for the sign
// accepts it while the TypeScript client's digits-only shape does
// not.
func TestANegativeRetryAfterFallsBackToThePolicy(t *testing.T) {
	for _, v := range []string{"-5", "-0", "-1"} {
		resp := &http.Response{Header: http.Header{"Retry-After": []string{v}}}
		wait, ok, tooLong := retryAfter(resp, 30*time.Second)
		if ok || tooLong {
			t.Errorf("retryAfter(%q) = %v, ok=%v, tooLong=%v; want a fall back to the policy", v, wait, ok, tooLong)
		}
	}
}

// A Retry-After far past the cap must still read as too long. The
// first three wrap time.Duration's int64 nanoseconds - to -1s,
// -808ms and -2562047h - which would otherwise read as under any
// cap; the rest exceed int64 and so never reach the multiply.
func TestAnAbsurdRetryAfterDoesNotWrapIntoAnImmediateRetry(t *testing.T) {
	for _, v := range []string{
		"9223372036854775807", "9223372036854775", "9223372037",
		// Past int64 entirely: Atoi reports ErrRange, not a parse
		// failure, so these must not fall through to the policy.
		"9223372036854775808", "+9223372036854775808",
		"18446744073709551616", "99999999999999999999999999",
	} {
		resp := &http.Response{Header: http.Header{"Retry-After": []string{v}}}
		wait, ok, tooLong := retryAfter(resp, 30*time.Second)
		if ok {
			t.Errorf("retryAfter(%q) = %v, true; want ok=false", v, wait)
		}
		if !tooLong {
			t.Errorf("retryAfter(%q) tooLong=false; the caller then retries on its own backoff", v)
		}
	}
}

// What the cap means. Over the limit is "stop", not "ignore the
// header": falling back to the policy's backoff retried a server
// that asked for an hour after one second, which is the opposite of
// what it asked for.
func TestTooLongRetryAfterStopsRatherThanRetryingSooner(t *testing.T) {
	var attempts int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		attempts++
		w.Header().Set("Retry-After", "3600")
		w.WriteHeader(http.StatusTooManyRequests)
	}))
	defer srv.Close()

	req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
	if err != nil {
		t.Fatal(err)
	}
	start := time.Now()
	resp, err := NewHTTPClient("test").Do(req)
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()

	if attempts != 1 {
		t.Errorf("attempts = %d, want 1: the server asked for an hour", attempts)
	}
	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
		t.Errorf("waited %v before giving up", elapsed)
	}
	if resp.StatusCode != http.StatusTooManyRequests {
		t.Errorf("status = %d, want the 429 handed back", resp.StatusCode)
	}
}

func TestRetryAfterAcceptsAnHTTPDate(t *testing.T) {
	when := time.Now().Add(3 * time.Second).UTC().Format(http.TimeFormat)
	resp := &http.Response{Header: http.Header{"Retry-After": []string{when}}}
	d, ok, _ := retryAfter(resp, 30*time.Second)
	if !ok {
		t.Fatal("rejected a valid HTTP-date")
	}
	if d < 1*time.Second || d > 4*time.Second {
		t.Errorf("parsed delay = %v, want about 3s", d)
	}
}

// A leading plus is a valid sign on an integer, and the cap decides
// by the value rather than the shape: a delay at the cap is honoured
// and one past it is refused, so the caller backs off on its own.
func TestRetryAfterReadsSignedSecondsAndTheCap(t *testing.T) {
	for _, c := range []struct {
		header  string
		want    time.Duration
		tooLong bool
	}{
		{"+5", 5 * time.Second, false},
		{"30", 30 * time.Second, false},
		{"31", 0, true},
	} {
		resp := &http.Response{Header: http.Header{"Retry-After": []string{c.header}}}
		wait, ok, tooLong := retryAfter(resp, 30*time.Second)
		switch {
		case tooLong != c.tooLong:
			t.Errorf("retryAfter(%q) tooLong = %v, want %v", c.header, tooLong, c.tooLong)
		case c.tooLong:
		case !ok:
			t.Errorf("retryAfter(%q) rejected a valid delay", c.header)
		case wait != c.want:
			t.Errorf("retryAfter(%q) = %v, want %v", c.header, wait, c.want)
		}
	}
}

func TestUnparseableRetryAfterFallsBackToThePolicy(t *testing.T) {
	resp := &http.Response{Header: http.Header{"Retry-After": []string{"soon-ish"}}}
	if _, ok, _ := retryAfter(resp, 30*time.Second); ok {
		t.Error("accepted an unparseable Retry-After")
	}
}

// A retried request has to send the SAME body it was given. The first
// attempt drains req.Body, so replaying without rewinding sends an
// empty one - and because Content-Length is already set, a server can
// hang waiting for bytes that never come rather than fail cleanly.
//
// PUT and DELETE are both retryable and both carry bodies, so this is
// reachable with the default policy.
func TestRetriedRequestResendsItsBody(t *testing.T) {
	// Guarded because the handler runs on net/http's own goroutine.
	// Retries are sequential today, so nothing races - but the
	// counters elsewhere in this file are atomic for the same reason,
	// and a test should not be the one place shaped like a race.
	var mu sync.Mutex
	var bodies []string
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		b, _ := io.ReadAll(r.Body)
		mu.Lock()
		bodies = append(bodies, string(b))
		n := len(bodies)
		mu.Unlock()
		if n == 1 {
			w.WriteHeader(http.StatusTooManyRequests)
			return
		}
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	req, err := http.NewRequest(http.MethodPut, srv.URL, strings.NewReader("the payload"))
	if err != nil {
		t.Fatal(err)
	}
	resp, err := NewHTTPClient("test").Do(req)
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()

	if len(bodies) != 2 {
		t.Fatalf("attempts = %d, want 2", len(bodies))
	}
	if bodies[1] != "the payload" {
		t.Errorf("retry sent %q, want %q - the body was not rewound", bodies[1], "the payload")
	}
}

// A body with no GetBody cannot be replayed, so it must not be
// retried: a half-sent request repeated is worse than one failure.
func TestUnreplayableBodyIsNotRetried(t *testing.T) {
	var attempts int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		attempts++
		_, _ = io.Copy(io.Discard, r.Body)
		w.WriteHeader(http.StatusTooManyRequests)
	}))
	defer srv.Close()

	req, err := http.NewRequest(http.MethodPut, srv.URL, io.NopCloser(strings.NewReader("x")))
	if err != nil {
		t.Fatal(err)
	}
	req.GetBody = nil // what a non-rewindable reader gives you

	resp, err := NewHTTPClient("test").Do(req)
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()

	if attempts != 1 {
		t.Errorf("attempts = %d, want 1: an unreplayable body must not be retried", attempts)
	}
}

// A backoff must not outlive the caller. The server decides how long
// Retry-After parks us - up to maxRetryAfter - and sleeping through a
// cancelled context holds a goroutine to produce an answer nobody is
// waiting for.
func TestBackoffStopsWhenTheCallerGivesUp(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Retry-After", "5")
		w.WriteHeader(http.StatusTooManyRequests)
	}))
	defer srv.Close()

	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, srv.URL, nil)
	if err != nil {
		t.Fatal(err)
	}

	start := time.Now()
	if _, err := NewHTTPClient("test").Do(req); err == nil {
		t.Error("want the context error, got nil")
	}

	if elapsed := time.Since(start); elapsed > time.Second {
		t.Errorf("waited %v after a 50ms deadline; the backoff ignored the context", elapsed)
	}
}

// trippingBreaker opens on the first failed request, for tests about
// what happens AFTER the circuit opens. MinRequests 1 and 100% say
// "one failure and nothing else is enough", which keeps those tests
// from depending on the default rate.
func trippingBreaker(cooldown time.Duration) *Breaker {
	return &Breaker{Policy: BreakerPolicy{
		Window:      time.Hour,
		MinRequests: 1,
		FailPercent: 100,
		Cooldown:    cooldown,
	}}
}

// Half-open means ONE caller finds out whether the dependency is
// back. Releasing everyone who waited out the cooldown aims the whole
// blocked set at something that has just proved it is struggling -
// the stampede the breaker exists to prevent.
func TestHalfOpenReleasesOneProbe(t *testing.T) {
	b := trippingBreaker(10 * time.Millisecond)
	for i := 0; i < 3; i++ {
		b.record(unwell)
	}
	if b.allow() {
		t.Fatal("breaker should be open immediately after tripping")
	}
	time.Sleep(20 * time.Millisecond)

	var allowed atomic.Int32
	var wg sync.WaitGroup
	for i := 0; i < 100; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			if b.allow() {
				allowed.Add(1)
			}
		}()
	}
	wg.Wait()

	if got := allowed.Load(); got != 1 {
		t.Errorf("admitted %d of 100, want 1", got)
	}
}

// A failed probe means the dependency is still down, so the cooldown
// starts again rather than letting the next caller straight through.
func TestFailedProbeReArmsTheCooldown(t *testing.T) {
	b := trippingBreaker(10 * time.Millisecond)
	b.record(unwell)
	time.Sleep(20 * time.Millisecond)

	if !b.allow() {
		t.Fatal("the probe should have been released after the cooldown")
	}
	b.record(unwell) // the probe failed

	if b.allow() {
		t.Error("a failed probe must re-arm the cooldown, not reopen the gate")
	}
}

// Requests in flight when the breaker tripped land after it. Counting
// their failures without moving openedAt measures the cooldown from
// the first trip, so it expires early.
func TestLateFailureMovesTheCooldown(t *testing.T) {
	b := trippingBreaker(time.Hour)
	for i := 0; i < 3; i++ {
		b.record(unwell)
	}
	first := b.openedAt

	time.Sleep(5 * time.Millisecond)
	b.record(unwell)

	if b.openedAt.Equal(first) {
		t.Error("openedAt did not move on a failure after the trip")
	}
}

// ExponentialRetry's shape, not just its count. Borrowed from wag's
// TestExponentialClientRetries, which asserts the gap between
// attempts rather than trusting the policy to be wired up.
//
// The window is wide because the backoff carries +/-25% jitter by
// design - a fleet retrying in lockstep arrives as one wave - so this
// pins the doubling without pinning the jitter.
func TestExponentialRetryActuallyBacksOff(t *testing.T) {
	var mu sync.Mutex
	var times []time.Time
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		mu.Lock()
		times = append(times, time.Now())
		n := len(times)
		mu.Unlock()
		if n < 3 {
			w.WriteHeader(http.StatusServiceUnavailable)
			return
		}
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
	if err != nil {
		t.Fatal(err)
	}
	resp, err := NewHTTPClient("test", WithPolicy(ExponentialRetry{})).Do(req)
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()

	if len(times) != 3 {
		t.Fatalf("attempts = %d, want 3", len(times))
	}
	// First backoff ~100ms, second ~200ms: the point is that the
	// second is longer than the first, not that either is exact.
	first := times[1].Sub(times[0])
	second := times[2].Sub(times[1])
	if first < 50*time.Millisecond || first > 200*time.Millisecond {
		t.Errorf("first backoff %v, want roughly 100ms", first)
	}
	if second <= first {
		t.Errorf("second backoff %v did not exceed the first %v: it is not backing off", second, first)
	}
}

// A connection that never lands is retried too - the policy's `err !=
// nil` arm. wag's TestNetworkErrorRetries covers the same ground via
// an unresolvable host; a closed listener is faster and offline-safe.
func TestTransportFailureIsRetried(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
	url := srv.URL
	srv.Close() // nothing is listening now

	req, err := http.NewRequest(http.MethodGet, url, nil)
	if err != nil {
		t.Fatal(err)
	}
	start := time.Now()
	if _, err := NewHTTPClient("test").Do(req); err == nil {
		t.Fatal("want a transport error, got nil")
	}

	// SingleRetry waits a second between its two attempts, so a
	// single-attempt run would come back far sooner.
	if elapsed := time.Since(start); elapsed < 900*time.Millisecond {
		t.Errorf("returned after %v: the transport failure was not retried", elapsed)
	}
}

// The half-open probe is a loan: allow() hands it out, record() takes
// it back. A probe that returns without reporting - a caller who
// cancels mid-backoff, which is routine in a CLI or a phone app -
// leaves the breaker believing it is still in flight, and allow()
// then refuses everyone for good. Wedged closed does not heal, so it
// is worse than the stampede the probe gate replaced.
func TestCancelledProbeDoesNotWedgeTheBreaker(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Retry-After", "5")
		w.WriteHeader(http.StatusServiceUnavailable)
	}))
	defer srv.Close()

	b := trippingBreaker(10 * time.Millisecond)
	c := NewHTTPClient("test", withBreaker(b))

	// Trip it.
	req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
	if err != nil {
		t.Fatal(err)
	}
	resp, err := c.Do(req)
	if err == nil {
		resp.Body.Close()
	}
	time.Sleep(20 * time.Millisecond)

	// Take the probe, then give up while it is backing off.
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
	defer cancel()
	probe, err := http.NewRequestWithContext(ctx, http.MethodGet, srv.URL, nil)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := c.Do(probe); err == nil {
		t.Fatal("want the context error from the abandoned probe")
	}

	// The breaker has to be usable again once the cooldown lapses.
	time.Sleep(30 * time.Millisecond)
	if !b.allow() {
		t.Error("breaker wedged: the abandoned probe was never returned")
	}
}

// A breaker counts evidence that the SERVICE is unwell. A caller
// changing its mind is not that: three impatient taps in a CLI or a
// phone app must not open the circuit against a server answering
// fine.
func TestCancellationIsNotADependencyFailure(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		time.Sleep(200 * time.Millisecond)
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	b := trippingBreaker(time.Hour)
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))

	for i := 0; i < 3; i++ {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
		req, err := http.NewRequestWithContext(ctx, http.MethodGet, srv.URL, nil)
		if err != nil {
			cancel()
			t.Fatal(err)
		}
		resp, err := c.Do(req)
		if err == nil {
			resp.Body.Close()
		}
		cancel()
	}

	if !b.allow() {
		t.Error("cancelled requests opened the circuit against a healthy server")
	}
}

// A permanently unimplemented route does not become implemented on
// the next attempt, so retrying it only spends the budget.
func TestPermanentProtocolErrorsAreNotRetried(t *testing.T) {
	var attempts int
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		attempts++
		w.WriteHeader(http.StatusNotImplemented)
	}))
	defer srv.Close()

	req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
	if err != nil {
		t.Fatal(err)
	}
	resp, err := NewHTTPClient("test").Do(req)
	if err != nil {
		t.Fatal(err)
	}
	resp.Body.Close()

	if attempts != 1 {
		t.Errorf("attempts = %d, want 1: a 501 will not become a 200", attempts)
	}
}

// 501 and 505 are permanent protocol answers, not outages. They do
// not recover after a cooldown, so counting them would leave the
// breaker flapping open forever against a service working as built.
func TestPermanentProtocolErrorsAreNotDependencyFailures(t *testing.T) {
	for _, status := range []int{http.StatusNotImplemented, http.StatusHTTPVersionNotSupported} {
		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
			w.WriteHeader(status)
		}))

		b := trippingBreaker(time.Hour)
		c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))
		for i := 0; i < 3; i++ {
			req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
			if err != nil {
				t.Fatal(err)
			}
			resp, err := c.Do(req)
			if err == nil {
				resp.Body.Close()
			}
		}
		srv.Close()

		if !b.allow() {
			t.Errorf("status %d opened the circuit; it will never heal", status)
		}
	}
}

// A 500 still counts: that is the case the breaker exists for.
func TestServerErrorsStillTripTheBreaker(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusInternalServerError)
	}))
	defer srv.Close()

	b := trippingBreaker(time.Hour)
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))
	for i := 0; i < 2; i++ {
		req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
		if err != nil {
			t.Fatal(err)
		}
		resp, err := c.Do(req)
		if err == nil {
			resp.Body.Close()
		}
	}

	if b.allow() {
		t.Error("two 500s should have opened the circuit")
	}
}

// Our own per-attempt Timeout firing is NOT the caller giving up. A
// service too slow to answer within it is unwell, which is a case the
// breaker exists for - and both situations surface as
// context.DeadlineExceeded, so the error alone cannot tell them
// apart.
func TestAHungDependencyStillTripsTheBreaker(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		time.Sleep(2 * time.Second)
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	b := trippingBreaker(time.Hour)
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}), WithTimeout(20*time.Millisecond))
	for i := 0; i < 3; i++ {
		req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
		if err != nil {
			t.Fatal(err)
		}
		resp, err := c.Do(req)
		if err == nil {
			resp.Body.Close()
		}
	}

	if b.allow() {
		t.Error("a dependency that never answers did not trip the breaker")
	}
}

// "Tells us nothing" is not "went fine". A service answering 500 on
// one route and 501 on another is still down, but if the 501s reset
// the count the 500s built up, the circuit never opens.
func TestAnIgnoredOutcomeDoesNotEraseRealFailures(t *testing.T) {
	var n atomic.Int32
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		if n.Add(1)%2 == 1 {
			w.WriteHeader(http.StatusInternalServerError)
			return
		}
		w.WriteHeader(http.StatusNotImplemented)
	}))
	defer srv.Close()

	b := trippingBreaker(time.Hour)
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))
	for i := 0; i < 20; i++ {
		req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
		if err != nil {
			t.Fatal(err)
		}
		resp, err := c.Do(req)
		if err == nil {
			resp.Body.Close()
		}
	}

	if b.allow() {
		t.Error("ten 500s did not open the circuit; the interleaved 501s erased them")
	}
}

// A dependency that comes back closes the circuit, on the evidence of
// the probe that found it back. The window is cleared with it: those
// failures are what opened the circuit, and holding them would re-open
// it on the next read against a dependency that has just answered.
func TestRecoveryClosesTheCircuit(t *testing.T) {
	var n atomic.Int32
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		if n.Add(1) <= 20 {
			w.WriteHeader(http.StatusInternalServerError)
			return
		}
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	// Long enough to assert on an open circuit, short enough to wait
	// out below.
	p := DefaultBreakerPolicy()
	p.Cooldown = 20 * time.Millisecond
	b := &Breaker{Policy: p}
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))

	do := func() error {
		req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
		if err != nil {
			t.Fatal(err)
		}
		resp, err := c.Do(req)
		if err == nil {
			resp.Body.Close()
		}
		return err
	}

	for i := 0; i < p.MinRequests; i++ {
		do()
	}
	if err := do(); err != ErrCircuitOpen {
		t.Fatalf("a dependency failing every request stayed closed: %v", err)
	}

	// The probe the cooldown releases finds the dependency answering.
	time.Sleep(p.Cooldown * 2)
	if err := do(); err != nil {
		t.Fatalf("the probe was refused or failed: %v", err)
	}
	if err := do(); err != nil {
		t.Errorf("a successful probe did not close the circuit: %v", err)
	}
}

// The bug a consecutive count had: one success in three kept the
// circuit closed against a dependency failing two requests in three.
// A rate cannot be cleared by a single success.
func TestASuccessAloneDoesNotClearAFailingRate(t *testing.T) {
	b := &Breaker{Policy: BreakerPolicy{
		Window:      time.Hour,
		MinRequests: 20,
		FailPercent: 50,
		Cooldown:    30 * time.Second,
	}}
	for i := 0; i < 30; i++ {
		if i%3 == 2 {
			b.record(healthy)
			continue
		}
		b.record(unwell)
	}
	if b.allow() {
		t.Error("two failures in three left the circuit closed")
	}
}

// A successful probe takes the window with it. Those failures are
// what opened the circuit; left in place they are still a failing
// rate, so the next request would re-open it against a dependency
// that has just answered.
func TestASuccessfulProbeClearsTheWindow(t *testing.T) {
	var n atomic.Int32
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		if n.Add(1) <= 20 {
			w.WriteHeader(http.StatusInternalServerError)
			return
		}
		w.WriteHeader(http.StatusOK)
	}))
	defer srv.Close()

	p := DefaultBreakerPolicy()
	p.Cooldown = 20 * time.Millisecond
	b := &Breaker{Policy: p}
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))

	do := func() error {
		req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
		if err != nil {
			t.Fatal(err)
		}
		resp, err := c.Do(req)
		if err == nil {
			resp.Body.Close()
		}
		return err
	}

	for i := 0; i < p.MinRequests; i++ {
		do()
	}
	time.Sleep(p.Cooldown * 2)
	if err := do(); err != nil {
		t.Fatalf("the probe was refused or failed: %v", err)
	}

	// Two more, because a stale window does its damage one request
	// late: the request after the probe is admitted on the probe's
	// verdict and only then reads a rate still holding the twenty
	// failures, which shuts the circuit on the one after it.
	if err := do(); err != nil {
		t.Fatalf("the request after the probe was refused: %v", err)
	}
	if err := do(); err != nil {
		t.Errorf("the probe left its failures behind: %v", err)
	}
}

// A failing rate re-opens a circuit that a probe had closed, rather
// than needing the whole window to fill again.
func TestAStillFailingDependencyReOpens(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusInternalServerError)
	}))
	defer srv.Close()

	p := DefaultBreakerPolicy()
	p.Cooldown = time.Hour
	b := &Breaker{Policy: p}
	c := NewHTTPClient("test", withBreaker(b), WithPolicy(NoRetry{}))
	for i := 0; i < p.MinRequests*2; i++ {
		req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
		if err != nil {
			t.Fatal(err)
		}
		if resp, err := c.Do(req); err == nil {
			resp.Body.Close()
		}
	}
	if b.allow() {
		t.Error("a dependency failing every request left the circuit closed")
	}
}

// Zero does not mean "open at no failures": a caller who sets no
// window, or no minimum, has asked for no measurement. Each field
// alone, because a sweep that dropped one of them from off() would
// otherwise still pass on the others.
//
// Cooldown is set on every case so that an opened circuit stays shut
// while this looks at it - at zero, allow() releases a probe and
// answers true whether off() did anything or not.
func TestAPolicyAskingForNothingDisablesBreaking(t *testing.T) {
	full := DefaultBreakerPolicy()
	for _, c := range []struct {
		name   string
		policy BreakerPolicy
	}{
		{"no window", BreakerPolicy{MinRequests: full.MinRequests, FailPercent: full.FailPercent, Cooldown: full.Cooldown}},
		{"no minimum", BreakerPolicy{Window: full.Window, FailPercent: full.FailPercent, Cooldown: full.Cooldown}},
		{"no percentage", BreakerPolicy{Window: full.Window, MinRequests: full.MinRequests, Cooldown: full.Cooldown}},
	} {
		t.Run(c.name, func(t *testing.T) {
			b := &Breaker{Policy: c.policy}
			for i := 0; i < 50; i++ {
				b.record(unwell)
			}
			if !b.allow() {
				t.Error("a policy asking for no measurement opened the circuit")
			}
		})
	}
}

func TestAZeroValuedBreakerDisablesItself(t *testing.T) {
	if !(&Breaker{}).allow() {
		t.Error("a fresh zero-valued Breaker refused the first request")
	}

	// Through the allow/record pairing a caller actually uses: a bare
	// run of record() would leave a probe outstanding from the first
	// allow() and test a state Do never produces.
	b := &Breaker{}
	for i := 0; i < 5; i++ {
		if b.allow() {
			b.record(unwell)
		}
	}

	// The probe gate compares against a real clock, and a zero
	// Cooldown means it needs time.Since(openedAt) > 0 - so without a
	// gap this asserts that the monotonic clock advanced a nanosecond
	// between the last record() and here. It often has not: 60 of 200
	// bare runs failed. -race slows execution enough to hide it,
	// which is every sanctioned path - the Makefile runs -race - so
	// it would have failed for a consumer and never for us.
	time.Sleep(time.Millisecond)

	if !b.allow() {
		t.Error("a zero-valued Breaker started refusing traffic")
	}
}

// An ignored outcome from a request holding NO probe must not touch
// the clock. Do consults the breaker once, so requests already in
// flight when it tripped land afterwards; a caller cancelling one of
// those says nothing about the dependency and must not push its
// recovery further away.
func TestAnIgnoredNonProbeDoesNotDelayRecovery(t *testing.T) {
	b := trippingBreaker(50 * time.Millisecond)
	b.record(unwell)
	time.Sleep(30 * time.Millisecond)

	// Lands late, cancelled by its caller, holding no probe.
	b.record(ignore)

	time.Sleep(30 * time.Millisecond) // 60ms since the trip
	if !b.allow() {
		t.Error("the cooldown was restarted by a request that learned nothing")
	}
}

// The two ignore paths: only the probe decides whether the clock
// moves, because an ignored outcome is not a data point either way.
func TestIgnoreArmsTheClockOnlyForAProbe(t *testing.T) {
	marker := time.Unix(1, 0)

	held := trippingBreaker(time.Hour)
	held.probing, held.openedAt = true, marker
	held.record(ignore)
	if held.probing {
		t.Error("the probe was not handed back")
	}
	if held.openedAt.Equal(marker) {
		t.Error("an ignored probe must spend its slot and arm the clock")
	}

	none := trippingBreaker(time.Hour)
	none.openedAt = marker
	none.record(ignore)
	if !none.openedAt.Equal(marker) {
		t.Error("an ignored non-probe armed the clock and delayed recovery")
	}
}

// Prints what this client answers for each shared Retry-After case,
// for the harness that compares the languages. Printed rather than
// asserted: no expected answer exists here, because what is checked
// is that every client says the same.
//
// stdout because the comparison runs in another process. A file would
// need somewhere to put it, and that somewhere can hold a stale
// answer from a previous run.
//
// One JSON object on one line, so a test that prints something
// answer-shaped cannot amount to a second set of answers.
func TestPrintRetryAfterVerdicts(t *testing.T) {
	answers := map[string]string{}
	for _, in := range []string{
{{ range parityCases }}		{{ printf "%q" . }},
{{ end }}	} {
		resp := &http.Response{Header: http.Header{"Retry-After": []string{in}}}
		wait, ok, tooLong := retryAfter(resp, 30*time.Second)
		switch {
		case tooLong:
			answers[in] = "STOP"
		case ok:
			answers[in] = fmt.Sprintf("WAIT %dms", wait.Milliseconds())
		default:
			answers[in] = "FALLBACK"
		}
	}
	// Checked rather than discarded, though a map of strings has
	// nothing in it that can fail to marshal.
	out, err := json.Marshal(answers)
	if err != nil {
		t.Fatal(err)
	}
	fmt.Printf("PARITY %s\n", out)
}
